/* ============================================================
   AUTH OVERLAY — sits on top of the whole app until signed in
============================================================ */

body.auth-locked { overflow: hidden; }

.auth-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at center, #161621 0, #09090e 55%, #050509 100%);
    padding: 20px;
}

.auth-card {
    width: 100%;
    max-width: 360px;
    padding: 24px;
    border-radius: 14px;
    background: #111119;
    border: 1px solid #292938;
    box-shadow: 0 20px 60px rgba(0,0,0,.5);
}

.auth-brand { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
.auth-brand-icon { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 10px; background: #8b5cf6; color: white; font-weight: 900; flex-shrink: 0; }
.auth-brand h1 { margin: 0; font-size: 15px; letter-spacing: 1px; color: #eeeef5; }
.auth-brand span { color: #8f8fa3; font-size: 10px; }

.auth-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-bottom: 16px; }
.auth-tab { padding: 9px; border: 1px solid #292938; border-radius: 7px; background: #171721; color: #aaaabc; font-size: 11px; font-weight: 700; cursor: pointer; }
.auth-tab.active { background: #24183d; border-color: #8b5cf6; color: white; }

.auth-form { display: flex; flex-direction: column; gap: 4px; }
.auth-label { margin-top: 8px; color: #8f8fa3; font-size: 9px; font-weight: 700; letter-spacing: .5px; }
.auth-input { padding: 10px; border: 1px solid #292938; border-radius: 7px; background: #0c0c13; color: white; font-size: 12px; outline: none; }
.auth-input:focus { border-color: #8b5cf6; }
.auth-hint { color: #6b6b7d; font-size: 9px; margin-top: 2px; }
.auth-notice { color: #ccc; font-size: 11px; line-height: 1.5; margin: 0 0 4px; }

.auth-submit { margin-top: 14px; padding: 11px; border: 0; border-radius: 8px; background: #8b5cf6; color: white; font-size: 11px; font-weight: 800; cursor: pointer; }
.auth-submit:hover { background: #a78bfa; }

.auth-link { margin-top: 10px; background: none; border: none; color: #a78bfa; font-size: 10px; cursor: pointer; text-align: center; }
.auth-link:hover { color: white; text-decoration: underline; }

.auth-error { min-height: 14px; margin-top: 10px; color: #f87171; font-size: 10px; line-height: 1.4; }
.auth-success { min-height: 14px; margin-top: 10px; color: #4ade80; font-size: 10px; line-height: 1.4; }
